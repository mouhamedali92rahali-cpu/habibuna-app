<?xml version="1.0" encoding="utf-8"?>
<!-- بطاقة اليوم على الشاشة الرئيسية: الإطار بلون باب البطاقة، والزرّ «ﷺ» يمينًا والموعد القادم يسارًا (طلب المستخدم) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wroot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl">

    <ImageView
        android:id="@+id/wframe"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_frame"
        android:tint="#4A2A55" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:id="@+id/wpaper"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/widget_paper"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/wkicker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:text="من مواقف النبي ﷺ"
                android:textColor="#7A6A55"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/wtext"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="serif"
                android:gravity="center"
                android:lineSpacingMultiplier="1.2"
                android:text="افتح «حبيبنا» مرة لتظهر بطاقاتك هنا"
                android:textColor="#1D2A28"
                android:textDirection="rtl"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/wsrc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#7A6A55"
                android:textSize="10.5sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="6dp"
            android:paddingLeft="4dp"
            android:paddingRight="2dp">

            <FrameLayout
                android:id="@+id/wpray"
                android:layout_width="54dp"
                android:layout_height="54dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_pray" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="ﷺ"
                        android:textColor="#1D2A28"
                        android:textSize="21sp" />

                    <TextView
                        android:id="@+id/wcount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="0"
                        android:textColor="#1D2A28"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/wpraylab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="صلِّ عليه ﷺ"
                android:textColor="#F3E2A6"
                android:textSize="13sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/wnext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#F3E2A6"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
