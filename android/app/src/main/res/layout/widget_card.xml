<?xml version="1.0" encoding="utf-8"?>
<!-- زرّ الصلاة على النبي ﷺ (أ + ب، اختيار المستخدم 2026-11-10): الدائرة الذهبية يمينًا بعدد الأسبوع،
     خيط ذهبي ثانٍ يبدأ من تحت الدائرة ويحيط بالصيغة، ونجوم ثمانية باهتة في الخلفية، ونجمة في الطرف الأيسر.
     توهّج ذهبي حول الدائرة لحظة اللمس (wglow). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wroot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:layout_gravity="center_vertical"
        android:background="@drawable/widget_frame">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="30dp"
            android:layout_marginRight="60dp"
            android:scaleType="fitXY"
            android:src="@drawable/widget_stars" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="44dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:scaleType="fitXY"
            android:src="@drawable/widget_inner" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layoutDirection="rtl"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="16dp"
            android:paddingRight="4dp">

            <FrameLayout
                android:id="@+id/wpray"
                android:layout_width="76dp"
                android:layout_height="76dp">

                <ImageView
                    android:id="@+id/wglow"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_glow"
                    android:visibility="gone" />

                <ImageView
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:layout_gravity="center"
                    android:src="@drawable/widget_pray" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="ﷺ"
                        android:textColor="#14211F"
                        android:textSize="28sp" />

                    <TextView
                        android:id="@+id/wcount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="0"
                        android:textColor="#14211F"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/wtext"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="serif"
                android:gravity="center"
                android:lineSpacingMultiplier="1.1"
                android:maxLines="2"
                android:paddingLeft="4dp"
                android:paddingRight="6dp"
                android:text="اللَّهُمَّ صَلِّ وَسَلِّمْ عَلَى نَبِيِّنَا مُحَمَّدٍ"
                android:textColor="#14211F"
                android:textDirection="rtl"
                android:textSize="17sp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/widget_star" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
