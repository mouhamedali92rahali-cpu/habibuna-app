<?xml version="1.0" encoding="utf-8"?>
<!-- زرّ الصلاة على النبي ﷺ: شريط بارتفاع ثابت في وسط مساحة الأداة (ما زاد عنه شفاف)،
     الدائرة الذهبية يمينًا بعدد الأسبوع، وأمامها صيغة اليوم كاملة، وفي الطرف نجمة ثمانية -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wroot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_gravity="center_vertical"
        android:layoutDirection="rtl"
        android:background="@drawable/widget_frame"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="9dp">

        <FrameLayout
            android:id="@+id/wpray"
            android:layout_width="62dp"
            android:layout_height="62dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_pray" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="ﷺ"
                    android:textColor="#14211F"
                    android:textSize="27sp" />

                <TextView
                    android:id="@+id/wcount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="0"
                    android:textColor="#14211F"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/wtext"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="serif"
            android:gravity="center"
            android:lineSpacingMultiplier="1.1"
            android:maxLines="2"
            android:paddingLeft="6dp"
            android:paddingRight="8dp"
            android:text="اللَّهُمَّ صَلِّ وَسَلِّمْ عَلَى نَبِيِّنَا مُحَمَّدٍ"
            android:textColor="#1D2A28"
            android:textDirection="rtl"
            android:textSize="15sp" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/widget_star" />
    </LinearLayout>
</FrameLayout>
