<?xml version="1.0" encoding="utf-8"?>
<!-- «يومك على شاشة القفل»: الشكل نفسه داخل الإشعار حين يُفتح (طلب المستخدم 2026-11-19)؛ بارتفاع ثابت لأن الإشعار لا يمدّ محتواه -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hroot" android:layout_width="match_parent" android:layout_height="200dp">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/hw_edge" />
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:layout_margin="4dp" android:scaleType="fitXY" android:src="@drawable/hw_face" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:layoutDirection="rtl"
        android:gravity="center_vertical" android:orientation="vertical" android:paddingLeft="18dp" android:paddingRight="18dp" android:paddingTop="10dp" android:paddingBottom="10dp">

        <!-- التاريخ: نسختان في ViewFlipper فيمرّ من اليسار إلى اليمين كالتطبيق (إن كانت واجهة الهاتف تشغّل حركة الأدوات) -->
        <ViewFlipper android:id="@+id/hdflip" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:autoStart="true" android:flipInterval="15000" android:inAnimation="@anim/wslide_in" android:outAnimation="@anim/wslide_out">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal">
                <ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/widget_star" />
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical">
                    <TextView android:id="@+id/hhijri" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false"
                        android:fontFamily="serif" android:textStyle="bold" android:textSize="16sp" android:textColor="#0F5C4D" android:maxLines="1" android:textDirection="rtl" />
                    <TextView android:id="@+id/hgreg" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="12sp" android:textColor="#6B6650" android:maxLines="1" android:textDirection="rtl" />
                </LinearLayout>
                <ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/widget_star" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal">
                <ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/widget_star" />
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical">
                    <TextView android:id="@+id/hhijri2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false"
                        android:fontFamily="serif" android:textStyle="bold" android:textSize="16sp" android:textColor="#0F5C4D" android:maxLines="1" android:textDirection="rtl" />
                    <TextView android:id="@+id/hgreg2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="12sp" android:textColor="#6B6650" android:maxLines="1" android:textDirection="rtl" />
                </LinearLayout>
                <ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/widget_star" />
            </LinearLayout>
        </ViewFlipper>

        <ImageView android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="6dp" android:layout_marginBottom="6dp" android:scaleType="fitXY" android:src="@drawable/hw_rule" />

        <!-- الصلاة القادمة بشكل التطبيق: «المغرب بعد 34 دقيقة» بين رسمين للنبض -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal">
            <ImageView android:layout_width="34dp" android:layout_height="12dp" android:src="@drawable/hw_pulse" />
            <TextView android:id="@+id/pline" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_marginEnd="6dp"
                android:textSize="14sp" android:textColor="#6B6650" android:maxLines="1" android:textDirection="rtl" />
            <ImageView android:layout_width="34dp" android:layout_height="12dp" android:src="@drawable/hw_pulse" />
        </LinearLayout>

        <ImageView android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="6dp" android:layout_marginBottom="6dp" android:scaleType="fitXY" android:src="@drawable/hw_rule" />

        <!-- المهمة والسنن وتذكير الوقت تتبادل كل سبع ثوانٍ (الأسطر تُضاف من HomeWidgets) -->
        <ViewFlipper android:id="@+id/hrot" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:autoStart="true" android:flipInterval="7000" android:inAnimation="@android:anim/fade_in" android:outAnimation="@android:anim/fade_out" />
    </LinearLayout>
</FrameLayout>
