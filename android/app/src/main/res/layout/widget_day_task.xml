<?xml version="1.0" encoding="utf-8"?>
<!-- المهمة الخفيّة داخل التناوب: دائرتان بكلمة صغيرة، «فعلتُها» زمردية و«لاحقًا» بإطار ذهبي (اختيار المستخدم (ب) 2026-11-19) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent"
    android:layoutDirection="rtl" android:gravity="center_vertical" android:orientation="horizontal">
    <TextView android:id="@+id/ttext" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:fontFamily="serif" android:textSize="14sp" android:textColor="#1D2A28" android:maxLines="3" android:ellipsize="end"
        android:lineSpacingMultiplier="0.95" android:textDirection="rtl" android:gravity="start|center_vertical" />
    <LinearLayout android:id="@+id/tdone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
        android:orientation="vertical" android:gravity="center_horizontal">
        <TextView android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/hw_circ_ok" android:gravity="center"
            android:text="✓" android:textStyle="bold" android:textSize="17sp" android:textColor="#FFFFFF" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="فعلتُها" android:textStyle="bold"
            android:textSize="10sp" android:textColor="#5A5446" android:includeFontPadding="false" android:layout_marginTop="2dp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/tlater" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
        android:orientation="vertical" android:gravity="center_horizontal">
        <TextView android:layout_width="30dp" android:layout_height="30dp" android:layout_marginTop="2dp" android:background="@drawable/hw_circ_later" android:gravity="center"
            android:text="↻" android:textStyle="bold" android:textSize="16sp" android:textColor="#B8892E" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="لاحقًا" android:textStyle="bold"
            android:textSize="10sp" android:textColor="#5A5446" android:includeFontPadding="false" android:layout_marginTop="4dp" />
    </LinearLayout>
</LinearLayout>
