<?xml version="1.0" encoding="utf-8"?>
<!-- التاريخ الميلادي والهجري (تجربة 2026-11-18) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hroot" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/hw_edge" />
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:layout_margin="4dp" android:scaleType="fitXY" android:src="@drawable/hw_face" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:layoutDirection="rtl"
        android:gravity="center" android:orientation="horizontal" android:paddingLeft="18dp" android:paddingRight="18dp">
        <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/widget_star" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical">
            <TextView android:id="@+id/hhijri" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="serif" android:textStyle="bold" android:textSize="17sp" android:textColor="#0F5C4D" android:maxLines="1" android:textDirection="rtl" />
            <TextView android:id="@+id/hgreg" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="12.5sp" android:textColor="#6B6650" android:maxLines="1" android:textDirection="rtl" />
        </LinearLayout>
        <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/widget_star" />
    </LinearLayout>
</FrameLayout>
