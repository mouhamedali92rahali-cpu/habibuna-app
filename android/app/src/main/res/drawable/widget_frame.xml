<?xml version="1.0" encoding="utf-8"?>
<!-- إطار زرّ الصلاة: حافّة زمردية، خيط ذهبي، وجه عاجي، وصفّ نجوم ثمانية باهتة في الوسط (أ + ب، اختيار المستخدم) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0F5C4D" />
            <corners android:radius="42dp" />
        </shape>
    </item>
    <item android:top="4dp" android:bottom="4dp" android:left="4dp" android:right="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#F6EFDD" />
            <stroke android:width="1.5dp" android:color="#C9A24A" />
            <corners android:radius="38dp" />
        </shape>
    </item>
    <item android:left="30dp" android:right="40dp" android:gravity="center_vertical" android:height="46dp">
        <bitmap android:src="@drawable/widget_star_tile" android:tileModeX="repeat" android:tileModeY="disabled" android:gravity="center_vertical" />
    </item>
</layer-list>
