{
 "quran": [
  {
   "id": "q29",
   "text": "﴿وَعَسَىٰ أَنْ تُحِبُّوا شَيْئًا وَهُوَ شَرٌّ لَكُمْ﴾",
   "src": "البقرة 216",
   "note": "النصف الذي ذكرتَه من الآية."
  },
  {
   "id": "q30",
   "text": "﴿وَاللَّهُ يَعْلَمُ وَأَنْتُمْ لَا تَعْلَمُونَ﴾",
   "src": "البقرة 216",
   "note": ""
  },
  {
   "id": "q31",
   "text": "﴿وَيَرْزُقْهُ مِنْ حَيْثُ لَا يَحْتَسِبُ﴾",
   "src": "الطلاق 3",
   "note": ""
  },
  {
   "id": "q32",
   "text": "﴿إِنَّ اللَّهَ يَغْفِرُ الذُّنُوبَ جَمِيعًا﴾",
   "src": "الزمر 53",
   "note": ""
  },
  {
   "id": "q33",
   "text": "﴿أُجِيبُ دَعْوَةَ الدَّاعِ إِذَا دَعَانِ﴾",
   "src": "البقرة 186",
   "note": ""
  },
  {
   "id": "q35",
   "text": "﴿وَبَشِّرِ الصَّابِرِينَ﴾",
   "src": "البقرة 155",
   "note": ""
  },
  {
   "id": "q36",
   "text": "﴿رَبِّ اشْرَحْ لِي صَدْرِي﴾",
   "src": "طه 25",
   "note": ""
  },
  {
   "id": "q37",
   "text": "﴿وَقُلْ رَبِّ زِدْنِي عِلْمًا﴾",
   "src": "طه 114",
   "note": ""
  },
  {
   "id": "q38",
   "text": "﴿لَا إِلَٰهَ إِلَّا أَنْتَ سُبْحَانَكَ إِنِّي كُنْتُ مِنَ الظَّالِمِينَ﴾",
   "src": "الأنبياء 87",
   "note": "دعاء يونس عليه السلام."
  },
  {
   "id": "q39",
   "text": "﴿إِنَّ اللَّهَ لَا يُغَيِّرُ مَا بِقَوْمٍ حَتَّىٰ يُغَيِّرُوا مَا بِأَنْفُسِهِمْ﴾",
   "src": "الرعد 11",
   "note": ""
  },
  {
   "id": "q40",
   "text": "﴿فَإِذَا عَزَمْتَ فَتَوَكَّلْ عَلَى اللَّهِ﴾",
   "src": "آل عمران 159",
   "note": ""
  },
  {
   "id": "q41",
   "text": "﴿وَلَوْ كُنْتَ فَظًّا غَلِيظَ الْقَلْبِ لَانْفَضُّوا مِنْ حَوْلِكَ﴾",
   "src": "آل عمران 159",
   "note": "بدل «فبما رحمة من الله لنت لهم» بطلب المستخدم؛ في النبي ﷺ."
  },
  {
   "id": "q42",
   "text": "﴿إِنَّ اللَّهَ يُحِبُّ التَّوَّابِينَ وَيُحِبُّ الْمُتَطَهِّرِينَ﴾",
   "src": "البقرة 222",
   "note": ""
  },
  {
   "id": "q43",
   "text": "﴿وَهُوَ مَعَكُمْ أَيْنَ مَا كُنْتُمْ﴾",
   "src": "الحديد 4",
   "note": ""
  },
  {
   "id": "q44",
   "text": "﴿اللَّهُ لَطِيفٌ بِعِبَادِهِ﴾",
   "src": "الشورى 19",
   "note": ""
  },
  {
   "id": "q45",
   "text": "﴿فَاللَّهُ خَيْرٌ حَافِظًا وَهُوَ أَرْحَمُ الرَّاحِمِينَ﴾",
   "src": "يوسف 64",
   "note": ""
  },
  {
   "id": "q46",
   "text": "﴿وَالْكَاظِمِينَ الْغَيْظَ وَالْعَافِينَ عَنِ النَّاسِ﴾",
   "src": "آل عمران 134",
   "note": ""
  },
  {
   "id": "q47",
   "text": "﴿رَبِّ ارْحَمْهُمَا كَمَا رَبَّيَانِي صَغِيرًا﴾",
   "src": "الإسراء 24",
   "note": "دعاء للوالدين."
  },
  {
   "id": "q48",
   "text": "﴿رَبَّنَا آتِنَا فِي الدُّنْيَا حَسَنَةً وَفِي الْآخِرَةِ حَسَنَةً وَقِنَا عَذَابَ النَّارِ﴾",
   "src": "البقرة 201",
   "note": ""
  },
  {
   "id": "q49",
   "text": "﴿هَلْ جَزَاءُ الْإِحْسَانِ إِلَّا الْإِحْسَانُ﴾",
   "src": "الرحمن 60",
   "note": ""
  },
  {
   "id": "q50",
   "text": "﴿وَاصْبِرُوا إِنَّ اللَّهَ مَعَ الصَّابِرِينَ﴾",
   "src": "الأنفال 46",
   "note": ""
  }
 ],
 "hadith": [
  {
   "id": "h25",
   "text": "«إن الله جميل يحبّ الجمال»",
   "src": "مسلم (91)",
   "note": ""
  },
  {
   "id": "h26",
   "text": "«الراحمون يرحمهم الرحمن»",
   "src": "الترمذي (1924)",
   "note": "قال الترمذي: حسن صحيح."
  },
  {
   "id": "h27",
   "text": "«ارحموا من في الأرض يرحمكم من في السماء»",
   "src": "الترمذي (1924)",
   "note": "قال الترمذي: حسن صحيح."
  },
  {
   "id": "h28",
   "text": "«إن الله كتب الإحسان على كل شيء»",
   "src": "مسلم (1955)",
   "note": ""
  },
  {
   "id": "h29",
   "text": "«من لا يشكر الناس لا يشكر الله»",
   "src": "الترمذي (1954)",
   "note": "قال الترمذي: حسن صحيح."
  },
  {
   "id": "h30",
   "text": "«أفشوا السلام بينكم»",
   "src": "مسلم (54)",
   "note": ""
  },
  {
   "id": "h31",
   "text": "«اتّق الله حيثما كنت، وأتبع السيئة الحسنة تمحها»",
   "src": "الترمذي (1987)",
   "note": "قال الترمذي: حسن صحيح."
  },
  {
   "id": "h32",
   "text": "«وخالق الناس بخلق حسن»",
   "src": "الترمذي (1987)",
   "note": "قال الترمذي: حسن صحيح."
  },
  {
   "id": "h33",
   "text": "«الحياء من الإيمان»",
   "src": "البخاري (24)",
   "note": ""
  },
  {
   "id": "h34",
   "text": "«إن الله لا ينظر إلى صوركم وأموالكم، ولكن ينظر إلى قلوبكم وأعمالكم»",
   "src": "مسلم (2564)",
   "note": ""
  },
  {
   "id": "h35",
   "text": "كان ﷺ يُكثر أن يقول: «يا مقلّب القلوب ثبّت قلبي على دينك»",
   "src": "الترمذي (2140)",
   "note": "قال الترمذي: حسن."
  },
  {
   "id": "h36",
   "text": "«من يُرد الله به خيرًا يفقّهه في الدين»",
   "src": "البخاري (71)",
   "note": ""
  },
  {
   "id": "h37",
   "text": "«كل معروف صدقة»",
   "src": "البخاري (6021)",
   "note": ""
  },
  {
   "id": "h38",
   "text": "«اتّقوا النار ولو بشقّ تمرة»",
   "src": "البخاري (1417)",
   "note": ""
  },
  {
   "id": "h39",
   "text": "«إن الصدق يهدي إلى البرّ، وإن البرّ يهدي إلى الجنة»",
   "src": "البخاري (6094)",
   "note": ""
  },
  {
   "id": "h40",
   "text": "«والله في عون العبد ما كان العبد في عون أخيه»",
   "src": "مسلم (2699)",
   "note": ""
  },
  {
   "id": "h41",
   "text": "«ومن يسّر على معسر يسّر الله عليه في الدنيا والآخرة»",
   "src": "مسلم (2699)",
   "note": ""
  },
  {
   "id": "h42",
   "text": "«ومن ستر مسلمًا ستره الله في الدنيا والآخرة»",
   "src": "مسلم (2699)",
   "note": ""
  },
  {
   "id": "h43",
   "text": "«ومن سلك طريقًا يلتمس فيه علمًا سهّل الله له به طريقًا إلى الجنة»",
   "src": "مسلم (2699)",
   "note": ""
  }
 ],
 "salat": []
}