{
 "quran": [
  {
   "id": "q70",
   "text": "﴿قُلْ إِنَّ صَلَاتِي وَنُسُكِي وَمَحْيَايَ وَمَمَاتِي لِلَّهِ رَبِّ الْعَالَمِينَ﴾",
   "src": "الأنعام 162",
   "note": ""
  },
  {
   "id": "q71",
   "text": "﴿إِنَّا لِلَّهِ وَإِنَّا إِلَيْهِ رَاجِعُونَ﴾",
   "src": "البقرة 156",
   "note": ""
  },
  {
   "id": "q72",
   "text": "﴿رَبَّنَا آتِنَا مِنْ لَدُنْكَ رَحْمَةً وَهَيِّئْ لَنَا مِنْ أَمْرِنَا رَشَدًا﴾",
   "src": "الكهف 10",
   "note": "دعاء أصحاب الكهف."
  },
  {
   "id": "q73",
   "text": "﴿وَإِنِّي لَغَفَّارٌ لِمَنْ تَابَ وَآمَنَ وَعَمِلَ صَالِحًا ثُمَّ اهْتَدَىٰ﴾",
   "src": "طه 82",
   "note": ""
  },
  {
   "id": "q74",
   "text": "﴿اسْتَغْفِرُوا رَبَّكُمْ إِنَّهُ كَانَ غَفَّارًا﴾",
   "src": "نوح 10",
   "note": ""
  },
  {
   "id": "q75",
   "text": "﴿وَاسْتَغْفِرُوا رَبَّكُمْ ثُمَّ تُوبُوا إِلَيْهِ إِنَّ رَبِّي رَحِيمٌ وَدُودٌ﴾",
   "src": "هود 90",
   "note": ""
  },
  {
   "id": "q76",
   "text": "﴿وَمَنْ يَعْمَلْ سُوءًا أَوْ يَظْلِمْ نَفْسَهُ ثُمَّ يَسْتَغْفِرِ اللَّهَ يَجِدِ اللَّهَ غَفُورًا رَحِيمًا﴾",
   "src": "النساء 110",
   "note": "أطول؛ تظهر في ثلاثة أسطر."
  },
  {
   "id": "q77",
   "text": "﴿وَرَحْمَتِي وَسِعَتْ كُلَّ شَيْءٍ﴾",
   "src": "الأعراف 156",
   "note": ""
  },
  {
   "id": "q78",
   "text": "﴿كَتَبَ رَبُّكُمْ عَلَىٰ نَفْسِهِ الرَّحْمَةَ﴾",
   "src": "الأنعام 54",
   "note": ""
  },
  {
   "id": "q79",
   "text": "﴿وَمَا بِكُمْ مِنْ نِعْمَةٍ فَمِنَ اللَّهِ﴾",
   "src": "النحل 53",
   "note": ""
  },
  {
   "id": "q80",
   "text": "﴿وَإِنْ تَعُدُّوا نِعْمَتَ اللَّهِ لَا تُحْصُوهَا﴾",
   "src": "إبراهيم 34",
   "note": ""
  },
  {
   "id": "q81",
   "text": "﴿أَنِ اشْكُرْ لِي وَلِوَالِدَيْكَ إِلَيَّ الْمَصِيرُ﴾",
   "src": "لقمان 14",
   "note": ""
  },
  {
   "id": "q82",
   "text": "﴿وَقَضَىٰ رَبُّكَ أَلَّا تَعْبُدُوا إِلَّا إِيَّاهُ وَبِالْوَالِدَيْنِ إِحْسَانًا﴾",
   "src": "الإسراء 23",
   "note": ""
  },
  {
   "id": "q83",
   "text": "﴿وَأَحْسِنُوا إِنَّ اللَّهَ يُحِبُّ الْمُحْسِنِينَ﴾",
   "src": "البقرة 195",
   "note": ""
  },
  {
   "id": "q84",
   "text": "﴿وَتَعَاوَنُوا عَلَى الْبِرِّ وَالتَّقْوَىٰ﴾",
   "src": "المائدة 2",
   "note": ""
  },
  {
   "id": "q85",
   "text": "﴿إِنَّمَا يُوَفَّى الصَّابِرُونَ أَجْرَهُمْ بِغَيْرِ حِسَابٍ﴾",
   "src": "الزمر 10",
   "note": ""
  },
  {
   "id": "q86",
   "text": "﴿وَأُفَوِّضُ أَمْرِي إِلَى اللَّهِ إِنَّ اللَّهَ بَصِيرٌ بِالْعِبَادِ﴾",
   "src": "غافر 44",
   "note": ""
  },
  {
   "id": "q87",
   "text": "﴿قُلْ لَنْ يُصِيبَنَا إِلَّا مَا كَتَبَ اللَّهُ لَنَا﴾",
   "src": "التوبة 51",
   "note": ""
  },
  {
   "id": "q88",
   "text": "﴿مَنْ يُطِعِ الرَّسُولَ فَقَدْ أَطَاعَ اللَّهَ﴾",
   "src": "النساء 80",
   "note": "في النبي ﷺ."
  },
  {
   "id": "q89",
   "text": "﴿وَمَا يَنْطِقُ عَنِ الْهَوَىٰ ۝ إِنْ هُوَ إِلَّا وَحْيٌ يُوحَىٰ﴾",
   "src": "النجم 3–4",
   "note": "في النبي ﷺ؛ آيتان متتاليتان."
  }
 ],
 "hadith": [
  {
   "id": "h57",
   "text": "«ما أكل أحد طعامًا قطّ خيرًا من أن يأكل من عمل يده»",
   "src": "البخاري (2072)",
   "note": ""
  },
  {
   "id": "h58",
   "text": "«ومن كان في حاجة أخيه كان الله في حاجته»",
   "src": "البخاري (2442)",
   "note": ""
  },
  {
   "id": "h59",
   "text": "«وكونوا عباد الله إخوانًا»",
   "src": "البخاري (6065)",
   "note": ""
  },
  {
   "id": "h60",
   "text": "سُئل: أيّ العمل أحبّ إلى الله؟ قال: «الصلاة على وقتها»",
   "src": "البخاري (527)",
   "note": ""
  },
  {
   "id": "h61",
   "text": "«ألا أدلّك على كلمة هي كنز من كنوز الجنة؟ لا حول ولا قوة إلا بالله»",
   "src": "البخاري (6384)",
   "note": ""
  },
  {
   "id": "h62",
   "text": "«اتّقوا الظلم، فإن الظلم ظلمات يوم القيامة»",
   "src": "مسلم (2578)",
   "note": ""
  },
  {
   "id": "h63",
   "text": "«ليس المؤمن بالطعّان ولا اللعّان ولا الفاحش ولا البذيء»",
   "src": "الترمذي (1977)",
   "note": "قال الترمذي: حسن غريب. «الطعّان»: الذي يعيب الناس في أعراضهم."
  },
  {
   "id": "h64",
   "text": "«لا يزال لسانك رطبًا من ذكر الله»",
   "src": "الترمذي (3375)",
   "note": "قال الترمذي: حسن غريب."
  },
  {
   "id": "h65",
   "text": "«اليد العليا خير من اليد السفلى»",
   "src": "البخاري (1427)",
   "note": "«العليا»: المعطية، و«السفلى»: الآخذة؛ قد لا يتّضح المعنى وحده."
  }
 ],
 "salat": []
}